{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BetterMD",
  "version": "0.1.1",
  "identifier": "com.bettermd.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "navigator",
        "title": "BetterMD",
        "width": 720,
        "height": 620,
        "minWidth": 620,
        "minHeight": 520,
        "resizable": true,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "ext": ["md"],
        "name": "BetterMD Markdown",
        "description": "BetterMD Markdown Document",
        "mimeType": "text/markdown",
        "role": "Editor"
      }
    ]
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAwODM0QjkzQzZFODQ4MjEKUldRaFNPakdrMHVEQVAreElUTDAxREk1RlA1ZE1GaXQyQXJuNFpsT1dwcW1sNGJoamo3Rmh5WFQK",
      "endpoints": [
        "https://github.com/silen2/better-md/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
